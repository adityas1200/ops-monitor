# Optional — enables the Claude harness so agents reason over their skill files.
# Without it, agents use deterministic fallbacks (platform stays fully functional).
ANTHROPIC_API_KEY=
# Corporate gateway URL (required if using an MGA token instead of a direct Anthropic key)
ANTHROPIC_BASE_URL=https://chat.int.bayer.com/anthropic
CLAUDE_MODEL=claude-sonnet-4.5
